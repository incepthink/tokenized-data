pragma language_version >= 0.28;
import CompactStandardLibrary;

// NexVault document vault.
//
// Identity: every user holds a 32-byte vault secret key that never leaves the
// browser. Their public identity ("vault id") is derivePk(secretKey). Circuits
// prove knowledge of the secret key in zero knowledge; only the public key and
// the hashes below are ever written to the ledger.

struct AccessKeyInput {
  tokenId: Uint<64>;
  viewer: Bytes<32>;
}

// Private input, supplied by the caller's browser and never transmitted.
witness secretKey(): Bytes<32>;

// ── Public ledger state ──────────────────────────────────────────────────────
export ledger tokenCounter:      Counter;
export ledger collectionCounter: Counter;

// Documents, keyed by tokenId
export ledger docHash:       Map<Uint<64>, Bytes<32>>;  // sha256 of the file
export ledger metadataHash:  Map<Uint<64>, Bytes<32>>;  // sha256 of title|category|description
export ledger ownerPk:       Map<Uint<64>, Bytes<32>>;  // owner's vault id
export ledger creatorPk:     Map<Uint<64>, Bytes<32>>;  // creator's vault id
export ledger docCollection: Map<Uint<64>, Uint<64>>;   // collection the document belongs to

// Collections, keyed by collectionId
export ledger collectionOwner: Map<Uint<64>, Bytes<32>>;

// Access control, keyed by accessKey(tokenId, viewerPk)
export ledger accessGrants: Map<Bytes<32>, Boolean>;    // true = access granted
export ledger accessLogs:   Map<Bytes<32>, Bytes<32>>;  // viewer's latest signature hash

// ── Pure helpers (also callable off-chain from TypeScript) ───────────────────
export pure circuit derivePk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "nexvault:pk:v1"), sk]);
}

export pure circuit accessKey(tokenId: Uint<64>, viewerPk: Bytes<32>): Bytes<32> {
  return persistentHash<AccessKeyInput>(AccessKeyInput { tokenId: tokenId, viewer: viewerPk });
}

// ── createCollection (creator) ───────────────────────────────────────────────
export circuit createCollection(): Uint<64> {
  const pk = disclose(derivePk(secretKey()));
  const colId = collectionCounter.read();
  collectionCounter.increment(1);
  collectionOwner.insert(colId, pk);
  return colId;
}

// ── mintDocument (creator) ───────────────────────────────────────────────────
// Only the creator of the collection can mint into it.
export circuit mintDocument(
  inputDocHash:      Bytes<32>,
  inputMetaHash:     Bytes<32>,
  inputOwnerPk:      Bytes<32>,
  inputCollectionId: Uint<64>
): Uint<64> {
  const pk = disclose(derivePk(secretKey()));
  const colId = disclose(inputCollectionId);
  assert(collectionOwner.member(colId), "Collection does not exist");
  assert(collectionOwner.lookup(colId) == pk, "Not the collection creator");
  const tokenId = tokenCounter.read();
  tokenCounter.increment(1);
  docHash.insert(tokenId, disclose(inputDocHash));
  metadataHash.insert(tokenId, disclose(inputMetaHash));
  ownerPk.insert(tokenId, disclose(inputOwnerPk));
  creatorPk.insert(tokenId, pk);
  docCollection.insert(tokenId, colId);
  return tokenId;
}

// ── grantAccess (owner) ──────────────────────────────────────────────────────
export circuit grantAccess(tokenId: Uint<64>, viewerPubKey: Bytes<32>): [] {
  const pk = disclose(derivePk(secretKey()));
  const id = disclose(tokenId);
  assert(ownerPk.member(id), "Document does not exist");
  assert(ownerPk.lookup(id) == pk, "Not the document owner");
  accessGrants.insert(accessKey(id, disclose(viewerPubKey)), true);
}

// ── revokeAccess (owner) ─────────────────────────────────────────────────────
export circuit revokeAccess(tokenId: Uint<64>, viewerPubKey: Bytes<32>): [] {
  const pk = disclose(derivePk(secretKey()));
  const id = disclose(tokenId);
  assert(ownerPk.member(id), "Document does not exist");
  assert(ownerPk.lookup(id) == pk, "Not the document owner");
  accessGrants.insert(accessKey(id, disclose(viewerPubKey)), false);
}

// ── signDocument (viewer) ────────────────────────────────────────────────────
// The viewer proves they hold the key that was granted access, then records a
// signature hash in the on-chain access log.
export circuit signDocument(tokenId: Uint<64>, sigHash: Bytes<32>): [] {
  const pk = disclose(derivePk(secretKey()));
  const id = disclose(tokenId);
  const key = accessKey(id, pk);
  assert(accessGrants.member(key), "Viewer does not have access");
  assert(accessGrants.lookup(key), "Viewer access was revoked");
  accessLogs.insert(key, disclose(sigHash));
}
